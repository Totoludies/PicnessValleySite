---
// Page d'accueil, partagée par / (français) et /en/ (anglais).
import { Picture } from 'astro:assets';
import Site from '../layouts/Site.astro';
import keyArt from '../assets/key-art.webp';
import { routes, t, formatDate, type Lang } from '../i18n';
import { getNotes, noteSlug, versionRange } from '../lib/notes';
import { GAME_VERSION } from '../site.config';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const r = routes[lang];
const latest = (await getNotes(lang)).slice(0, 2);
---

<Site lang={lang} alternate={lang === 'fr' ? routes.en.home : routes.fr.home} image={keyArt.src}>
	<section class="hero">
		<div class="hero__art">
			<Picture
				src={keyArt}
				formats={['avif', 'webp']}
				fallbackFormat="webp"
				widths={[640, 1024, 1600, 2000]}
				sizes="100vw"
				alt={lang === 'fr'
					? "Picness Valley : quatre habitants se reposent autour d'une grande pierre blanche, dans une vallée fleurie au pied des montagnes, près d'un village."
					: 'Picness Valley: four villagers rest around a large white stone, in a flowery valley below the mountains, near a village.'}
				loading="eager"
				fetchpriority="high"
			/>
		</div>
		<div class="hero__panel wrap">
			<p class="hero__tagline">{s.heroTagline}</p>
			<div class="hero__actions">
				<a class="btn btn--leaf" href={r.play}>▶ {s.heroPlay}</a>
				<a class="btn" href={r.wiki}>{s.heroWiki}</a>
			</div>
			<p class="hero__meta"><span class="badge">{s.alpha}</span> {s.version} {GAME_VERSION}</p>
		</div>
	</section>

	<section class="section" id="jeu">
		<div class="wrap pitch">
			<div class="parchment pitch__card">
				<h2 class="parchment__title">{s.pitchTitle}</h2>
				{s.pitch.map((p) => <p>{p}</p>)}
			</div>
			<ul class="needs" aria-label={s.needsTitle}>
				{s.needs.map((n) => (
					<li class="need">
						<img src={`/icons/needs/${n.icon}.webp`} alt="" width="72" height="72" loading="lazy" />
						<div>
							<h3>{n.name}</h3>
							<p>{n.text}</p>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section--sky">
		<div class="wrap">
			<div class="section__head">
				<h2>{s.seasonsTitle}</h2>
			</div>
			<ul class="seasons">
				{s.seasons.map((season) => (
					<li class={`season season--${season.key}`}>
						<div class="season__frame" style={`--frame: url('/ui/frame-${season.key}.webp')`}>
							<h3>{season.name}</h3>
							<p>{season.text}</p>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section--meadow">
		<div class="wrap">
			<div class="section__head">
				<h2>{s.jobsTitle}</h2>
				<p>{s.jobsIntro}</p>
			</div>
			<ul class="jobs">
				{s.jobs.map((j) => (
					<li class="job">
						<img src={`/icons/jobs/${j.icon}.webp`} alt="" width="96" height="96" loading="lazy" />
						<span>{j.name}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	{latest.length > 0 && (
		<section class="section">
			<div class="wrap">
				<div class="section__head">
					<h2>{s.notesTitle}</h2>
				</div>
				<ul class="latest">
					{latest.map((note) => (
						<li>
							<a class="note-card" href={`${r.notes}${noteSlug(note)}/`}>
								<span class="note-card__meta">
									<span class="badge">{versionRange(note)}</span>
									<time datetime={note.data.date.toISOString()}>{formatDate(note.data.date, lang)}</time>
								</span>
								<h3>{note.data.title}</h3>
								<p>{note.data.summary}</p>
							</a>
						</li>
					))}
				</ul>
				<p class="latest__all"><a href={r.notes}>{s.notesAll} →</a></p>
			</div>
		</section>
	)}

	<section class="section section--wood cta">
		<div class="wrap">
			<h2>{s.ctaTitle}</h2>
			<div class="hero__actions">
				<a class="btn btn--leaf" href={r.play}>▶ {s.heroPlay}</a>
				<a class="btn" href={r.wiki}>{s.heroWiki}</a>
			</div>
		</div>
	</section>
</Site>

<style>
	/* ---------- Illustration d'accueil ---------- */
	.hero {
		background: linear-gradient(#bfe0f5, var(--pv-parchment-light) 70%);
	}

	.hero__art :global(img) {
		width: 100%;
		max-height: calc(100svh - 64px);
		object-fit: cover;
		object-position: 50% 0%;
	}

	.hero__panel {
		position: relative;
		margin-top: -72px;
		padding: 24px clamp(16px, 4vw, 40px) 22px;
		text-align: center;
		color: var(--pv-parchment-light);
		background: var(--pv-wood) url('/ui/plank.webp') center / cover;
		border: 3px solid var(--pv-ink);
		border-radius: 18px;
		box-shadow: 0 3px 0 var(--pv-wood-light) inset, var(--pv-shadow);
		max-width: 860px;
	}

	.hero__tagline {
		margin: 0 0 18px;
		font-family: var(--pv-font-title);
		font-size: clamp(1.35rem, 3vw, 1.9rem);
		line-height: 1.25;
		text-shadow: 0 2px 0 var(--pv-ink);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
	}

	.hero__meta {
		margin: 16px 0 0;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--pv-parchment);
	}

	@media (max-width: 640px) {
		.hero__panel {
			margin-top: -24px;
			width: calc(100% - 24px);
		}
		.hero__actions .btn {
			width: 100%;
			font-size: 1.2rem;
		}
	}

	/* ---------- Le jeu + besoins ---------- */
	.pitch {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: 40px;
		align-items: center;
	}

	.pitch__card {
		font-size: 1.1rem;
	}

	.pitch__card p {
		margin: 0.6em 0;
	}

	.needs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 18px;
	}

	.need {
		display: flex;
		gap: 16px;
		align-items: center;
	}

	.need img {
		flex: none;
		width: 72px;
		height: 72px;
		object-fit: contain;
		filter: drop-shadow(0 3px 0 rgba(43, 29, 20, 0.2));
	}

	.need h3 {
		margin: 0;
		font-size: 1.4rem;
		color: var(--pv-wood-dark);
	}

	.need p {
		margin: 0;
		color: var(--pv-ink-soft);
	}

	@media (max-width: 860px) {
		.pitch {
			grid-template-columns: 1fr;
		}
	}

	/* ---------- Saisons : cadres de la frise du jeu ---------- */
	.seasons {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px;
	}

	.season__frame {
		position: relative;
		aspect-ratio: 2000 / 640;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 6% 18% 6% 8%;
		background:
			var(--frame) center / 100% 100% no-repeat,
			linear-gradient(var(--tint-a), var(--tint-b)) center / 96% 84% no-repeat;
		filter: drop-shadow(0 6px 10px rgba(43, 29, 20, 0.2));
	}

	.season__frame h3 {
		margin: 0 0 4px;
		font-size: clamp(1.3rem, 2.2vw, 1.7rem);
		color: var(--title);
		text-shadow: 0 2px 0 rgba(255, 255, 255, 0.6);
	}

	.season__frame p {
		margin: 0;
		font-size: clamp(0.9rem, 1.4vw, 1.02rem);
		line-height: 1.4;
		font-weight: 600;
		color: var(--pv-ink);
	}

	.season--spring {
		--tint-a: #fbeaf0;
		--tint-b: #eaf6d8;
		--title: #b4436b;
	}
	.season--summer {
		--tint-a: #fff3c4;
		--tint-b: #e2f2c2;
		--title: #3f7a1f;
	}
	.season--autumn {
		--tint-a: #fbe3c2;
		--tint-b: #f2cf9b;
		--title: #a4521c;
	}
	.season--winter {
		--tint-a: #f4f9fd;
		--tint-b: #d6e7f4;
		--title: #2f5b84;
	}

	@media (max-width: 860px) {
		.seasons {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 480px) {
		.season__frame {
			aspect-ratio: auto;
			min-height: 128px;
			padding: 26px 22px 22px;
		}
	}

	/* ---------- Métiers ---------- */
	.jobs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 18px;
	}

	.job {
		width: 132px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 16px 8px 12px;
		background: var(--pv-parchment-light);
		border: 3px solid var(--pv-ink);
		border-radius: var(--pv-radius);
		box-shadow: 0 4px 0 var(--pv-ink);
		font-family: var(--pv-font-title);
		font-size: 1.15rem;
		color: var(--pv-wood-dark);
		text-align: center;
	}

	.job img {
		width: 80px;
		height: 80px;
		object-fit: contain;
	}

	@media (max-width: 480px) {
		.job {
			width: calc(50% - 9px);
		}
	}

	/* ---------- Dernières notes ---------- */
	.latest {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 22px;
	}

	.note-card {
		display: block;
		height: 100%;
		padding: 22px 24px;
		color: var(--pv-ink);
		text-decoration: none;
		background: #fffaf0;
		border: 3px solid var(--pv-ink);
		border-radius: var(--pv-radius);
		box-shadow: 0 5px 0 var(--pv-ink);
		transition: transform 0.12s ease;
	}

	.note-card:hover {
		transform: translateY(-3px);
	}

	.note-card__meta {
		display: flex;
		gap: 10px;
		align-items: center;
		font-size: 0.9rem;
		color: var(--pv-ink-soft);
		margin-bottom: 10px;
	}

	.note-card h3 {
		color: var(--pv-wood-dark);
		margin-bottom: 6px;
	}

	.note-card p {
		margin: 0;
		color: var(--pv-ink-soft);
	}

	.latest__all {
		text-align: center;
		margin: 28px 0 0;
		font-weight: 800;
	}

	/* ---------- Appel final ---------- */
	.cta {
		text-align: center;
	}
</style>
