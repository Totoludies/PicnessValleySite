---
import NoteDetail from '../../../components/NoteDetail.astro';
import { getNotes, noteSlug } from '../../../lib/notes';

export async function getStaticPaths() {
	const notes = await getNotes('en');
	return notes.map((note) => ({ params: { slug: noteSlug(note) }, props: { note } }));
}

const { note } = Astro.props;
---

<NoteDetail lang="en" note={note} />
